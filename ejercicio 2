import json

# --- Definición de la excepción personalizada (si no está creada en el Punto A) ---
class StockInvalidoError(Exception):
    """Excepción lanzada cuando se intenta asignar un valor de stock inválido (negativo)."""
    pass

# --- Clase base de Dispositivos (Punto A) ---
class Dispositivo:
    def __init__(self, nombre, stock, precio):
        self.nombre = nombre
        self.stock = stock
        self.precio = precio

    @property
    def stock(self):
        return self._stock

    @stock.setter
    def stock(self, valor):
        if valor < 0:
            raise StockInvalidoError(f"Error de validación: El stock no puede ser negativo (valor ingresado: {valor}).")
        self._stock = valor

    def to_dict(self):
        """Convierte la instancia en un diccionario para facilitar la serialización JSON."""
        return {
            "nombre": self.nombre,
            "stock": self.stock,
            "precio": self.precio
        }

# --- Clase GestorInventario ---
class GestorInventario:
    @staticmethod
    def guardar_catalogo_json(lista_dispositivos, ruta_archivo):
        """
        Serializa y almacena una lista de dispositivos en formato JSON.
        """
        try:
            # Convertir cada objeto dispositivo a diccionario
            catalogo_datos = []
            for dispositivo in lista_dispositivos:
                if hasattr(dispositivo, 'to_dict'):
                    catalogo_datos.append(dispositivo.to_dict())
                else:
                    catalogo_datos.append(dispositivo.__dict__)

            # Guardar en el archivo JSON especificado
            with open(ruta_archivo, 'w', encoding='utf-8') as archivo:
                json.dump(catalogo_datos, archivo, ensure_ascii=False, indent=4)
                
            print(f"Catálogo guardado exitosamente en '{ruta_archivo}'.")
        except IOError as e:
            print(f"Error de E/S al intentar escribir el archivo: {e}")
        except Exception as e:
            print(f"Ocurrió un error inesperado durante la serialización: {e}")

