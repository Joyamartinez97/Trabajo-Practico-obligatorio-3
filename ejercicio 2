
# 1. Definición de la excepción personalizada
class StockInvalidoError(ValueError):
    """Excepción lanzada cuando se intenta asignar un valor de stock negativo."""
    def __init__(self, mensaje="El stock no puede ser un valor negativo."):
        super().__init__(mensaje)


# 2. Clase base con encapsulamiento explícito
class DispositivoEcológico:
    def __init__(self, nombre: str, precio: float, stock: int):
        self.__nombre = nombre
        self.__precio = precio
        self.stock = stock  # Utiliza la propiedad (setter) para validar desde el inicio

    # Encapsulamiento del atributo stock mediante property
    @property
    def stock(self) -> int:
        return self.__stock

    @stock.setter
    def stock(self, valor: int):
        if valor < 0:
            raise StockInvalidoError(
                f"Stock inválido ({valor}) para '{self.__nombre}'. El stock no puede ser negativo."
            )
        self.__stock = valor

    @property
    def nombre(self) -> str:
        return self.__nombre

    @property
    def precio(self) -> float:
        return self.__precio

    # Método base para la ficha técnica (susceptible a polimorfismo)
    def obtener_ficha_tecnica(self) -> str:
        return f"Producto: {self.__nombre} | Precio: ${self.__precio:.2f} | Stock: {self.__stock}"


# 3. Clase especializada que aplica herencia y polimorfismo
class PanelSolar(DispositivoEcológico):
    def __init__(self, nombre: str, precio: float, stock: int, potencia_vatios: float, eficiencia: float):
        super().__init__(nombre, precio, stock)
        self.__potencia_vatios = potencia_vatios
        self.__eficiencia = eficiencia  # Ej: 0.21 para 21%

    @property
    def potencia_vatios(self) -> float:
        return self.__potencia_vatios

    @property
    def eficiencia(self) -> float:
        return self.__eficiencia

    # Polimorfismo: Sobrescribimos el método para extender la información comercial específica
    def obtener_ficha_tecnica(self) -> str:
        ficha_base = super().obtener_ficha_tecnica()
        return (
            f"=== FICHA TÉCNICA COMERCIAL: PANEL SOLAR ===\n"
            f"{ficha_base}\n"
            f"• Potencia Nominal: {self.__potencia_vatios} W\n"
            f"• Eficiencia Energética: {self.__eficiencia * 100:.1f}%\n"
            f"============================================"
        )


# --- Ejemplo de uso y pruebas (ÚNICO lugar que va indentado dentro del if) ---
if __name__ == "__main__":
    try:
        # Creación exitosa de un panel solar
        mi_panel = PanelSolar(nombre="SolarMax 400W", precio=299.99, stock=15, potencia_vatios=400, eficiencia=0.22)
        print(mi_panel.obtener_ficha_tecnica())

        print("\nModificando stock de forma correcta...")
        mi_panel.stock = 10
        print(f"Stock actualizado: {mi_panel.stock}")

        print("\nIntentando asignar un stock negativo...")
        mi_panel.stock = -5  # Esto disparará la excepción StockInvalidoError

    except StockInvalidoError as e:
        print(f"[EXCEPCIÓN CAPTURADA]: {e}")


