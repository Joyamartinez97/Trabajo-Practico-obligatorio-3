# ==========================================
# 1. FUNCIÓN DE PROCESAMIENTO DE MÉTRICAS
# ==========================================
def calcular_emisiones_carbono(consumo_kwh, factor_emision=0.4):
    
    if consumo_kwh < 0:
        raise ValueError("El consumo en kWh no puede ser un valor negativo.")
    return consumo_kwh * factor_emision


def obtener_metricas_consumo(registros):
  
    if not registros:
        return {
            "total_emisiones": 0.0,
            "total_consumo": 0.0,
            "planta_mayor_consumo": None,
            "detalle_plantas": []
        }

    total_emisiones = 0.0
    total_consumo = 0.0
    mayor_consumo = -1.0
    planta_mayor_consumo = None
    detalle_plantas = []

    for reg in registros:
        nombre_planta = reg.get("planta", "Desconocida")
        consumo = reg.get("consumo_kwh", 0.0)
        # Permite un factor personalizado por registro o usa el valor por defecto
        factor = reg.get("factor_emision", 0.4)

        # Cálculo de emisiones invocando la función requerida
        emisiones = calcular_emisiones_carbono(consumo, factor)

        total_consumo += consumo
        total_emisiones += emisiones

        # Determinar la planta de mayor consumo
        if consumo > mayor_consumo:
            mayor_consumo = consumo
            planta_mayor_consumo = nombre_planta

        detalle_plantas.append({
            "planta": nombre_planta,
            "consumo_kwh": consumo,
            "emisiones_co2": emisiones
        })

    return {
        "total_emisiones": round(total_emisiones, 2),
        "total_consumo": round(total_consumo, 2),
        "planta_mayor_consumo": planta_mayor_consumo,
        "detalle_plantas": detalle_plantas
    }


