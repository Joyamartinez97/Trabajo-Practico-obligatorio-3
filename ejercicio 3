
import unittest

# --- Función requerida ---
def calcular_emisiones_carbono(consumo_kwh, factor_emision=0.4):
    """
    Calcula las emisiones de carbono basadas en el consumo eléctrico y un factor de emisión.
    Lanza ValueError si el consumo es negativo.
    """
    if consumo_kwh < 0:
        raise ValueError("El consumo en kWh no puede ser un valor negativo.")
    return consumo_kwh * factor_emision


# --- Clase de pruebas unitarias ---
class TestCalculoEmisiones(unittest.TestCase):
    
    def test_calculo_nominal_default(self):
        """Valida la exactitud numérica usando el factor de emisión por defecto (0.4)."""
        consumo = 100.0
        resultado_esperado = 40.0  # 100 * 0.4
        resultado_obtenido = calcular_emisiones_carbono(consumo)
        self.assertAlmostEqual(resultado_obtenido, resultado_esperado)

    def test_calculo_nominal_custom_factor(self):
        """Valida la exactitud numérica utilizando un factor de emisión personalizado."""
        consumo = 250.0
        factor = 0.55
        resultado_esperado = 137.5  # 250 * 0.55
        resultado_obtenido = calcular_emisiones_carbono(consumo, factor_emision=factor)
        self.assertAlmostEqual(resultado_obtenido, resultado_esperado)

    def test_calculo_consumo_cero(self):
        """Valida que un consumo de 0 kWh devuelva exactamente 0 de emisiones."""
        self.assertEqual(calcular_emisiones_carbono(0), 0.0)

    def test_excepcion_consumo_negativo(self):
        """Verifica que se eleve un ValueError de forma controlada ante un consumo negativo."""
        with self.assertRaises(ValueError) as contexto:
            calcular_emisiones_carbono(-15.5)
        
        # Opcional: Verificamos que el mensaje de la excepción sea el esperado
        self.assertEqual(str(contexto.exception), "El consumo en kWh no puede ser un valor negativo.")


if __name__ == "__main__":
    unittest.main()

