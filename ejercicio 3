from django.shortcuts import render

def vista_panel_sustentabilidad(request):
  
    registros_historicos = [
        {"planta": "Planta Central Buenos Aires", "consumo_kwh": 4500.0, "factor_emision": 0.38},
        {"planta": "Planta Norte Córdoba", "consumo_kwh": 6200.5, "factor_emision": 0.42},
        {"planta": "Planta Sur Mendoza", "consumo_kwh": 3100.0, "factor_emision": 0.35},
    ]

    metricas = obtener_metricas_consumo(registros_historicos)

    contexto = {
        "titulo_panel": "Panel de Control de Sustentabilidad - EcoTech",
        "total_emisiones": metricas["total_emisiones"],
        "total_consumo": metricas["total_consumo"],
        "planta_mayor_consumo": metricas["planta_mayor_consumo"],
        "detalle_plantas": metricas["detalle_plantas"],
    }
    return render(request, "sustentabilidad/panel.html", contexto)
